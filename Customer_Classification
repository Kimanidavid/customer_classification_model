ted"},"tags":[]},"source":["# Random Forest"]},{"cell_type":"code","execution_count":8,"id":"30c3837f","metadata":{"execution":{"iopub.execute_input":"2025-10-17T21:12:09.966109Z","iopub.status.busy":"2025-10-17T21:12:09.965768Z","iopub.status.idle":"2025-10-17T21:12:11.485375Z","shell.execute_reply":"2025-10-17T21:12:11.483859Z"},"papermill":{"duration":1.53044,"end_time":"2025-10-17T21:12:11.4871","exception":false,"start_time":"2025-10-17T21:12:09.95666","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Classification Report:\n"," |              | precision   | recall   | f1-score   | support   |\n","|:-------------|:------------|:---------|:-----------|:----------|\n","| Female       | 0.549902    | 0.751337 | 0.635028   | 374       |\n","| Male         | 0.858877    | 0.711055 | 0.778007   | 796       |\n","| accuracy     | 0.723932    | 0.723932 | 0.723932   | 0.723932  |\n","| macro avg    | 0.70439     | 0.731196 | 0.706518   | 1170      |\n","| weighted avg | 0.760111    | 0.723932 | 0.732303   | 1170      |\n","Accuracy: 0.7239\n"]}],"source":["from sklearn.model_selection import train_test_split\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.metrics import classification_report, confusion_matrix, accuracy_score\n","from sklearn.preprocessing import LabelEncoder\n","\n","# Drop Customer ID and Purchase Amount (USD) to avoid high correlation\n","df_model = df.drop(columns=['Purchase Amount (USD)'])\n","# Separate target variable (Gender) and encode it\n","le = LabelEncoder()\n","df_model['Gender'] = le.fit_transform(df_model['Gender'])\n","# Female: 0, Male: 1\n","\n","# Encode binary 'Yes'/'No' columns\n","binary_cols = ['Subscription Status', 'Discount Applied', 'Promo Code Used']\n","for col in binary_cols:\n","    df_model[col] = df_model[col].map({'Yes': 1, 'No': 0})\n","\n","# One-hot encode remaining categorical columns\n","categorical_cols = df_model.select_dtypes(include='object').columns\n","df_model = pd.get_dummies(df_model, columns=categorical_cols, drop_first=True)\n","\n","# Separate features (X) and target (y)\n","X = df_model.drop('Gender', axis=1)\n","y = df_model['Gender']\n","\n","# Split the data\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X, y, test_size=0.3, random_state=42, stratify=y\n",")\n","\n","# Initialize and train the Random Forest Classifier\n","rf_model = RandomForestClassifier(\n","    n_estimators=100, random_state=42, n_jobs=-1, max_depth=10, min_samples_leaf=5\n",")\n","rf_model.fit(X_train, y_train)\n","\n","# Make predictions\n","y_pred = rf_model.predict(X_test)\n","\n","#evaluating performance metrics\n","# Classification Report\n","report = classification_report(\n","    y_test, y_pred, target_names=le.classes_, output_dict=True\n",")\n","\n","report_df = pd.DataFrame(report).transpose()\n","print(\"Classification Report:\\n\", report_df.to_markdown(numalign=\"left\", stralign=\"left\"))\n","\n","#Accuracy\n","accuracy = accuracy_score(y_test, y_pred)\n","print(f\"Accuracy: {accuracy_score(y_test, y_pred):.4f}\")"]},{"cell_type":"code","execution_count":9,"id":"ca643e4b","metadata":{"execution":{"iopub.execute_input":"2025-10-17T21:12:11.502639Z","iopub.status.busy":"2025-10-17T21:12:11.502255Z","iopub.status.idle":"2025-10-17T21:12:11.713758Z","shell.execute_reply":"2025-10-17T21:12:11.712559Z"},"papermill":{"duration":0.222404,"end_time":"2025-10-17T21:12:11.716082","exception":false,"start_time":"2025-10-17T21:12:11.493678","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 800x600 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Confusion Matrix\n","cm = confusion_matrix(y_test, y_pred)\n","\n","# Plot Confusion Matrix\n","plt.figure(figsize=(8, 6))\n","sns.heatmap(\n","    cm, annot=True, fmt='d', cmap='Blues',\n","    xticklabels=le.classes_, yticklabels=le.classes_\n",")\n","plt.title('Confusion Matrix(RF)')\n